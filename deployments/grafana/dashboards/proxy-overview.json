      "title": "Active & Pool Connections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "active_connections",
          "legendFormat": "Active In-Flight"
        },
        {
          "expr": "connection_pool_active",
          "legendFormat": "Pool Active Leased"
        },
        {
          "expr": "connection_pool_idle",
          "legendFormat": "Pool Idle KeepAlive"
        }
      ]
    }
